# =====================================
# AI Financial Copilot Configuration
# =====================================

# FastAPI
APP_NAME=AI Financial Copilot
APP_VERSION=1.0.0
DEBUG=False

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./financial_copilot.db

# Security
SECRET_KEY=YOUR_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini AI
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY

# AI Model
GEMINI_MODEL=gemini-2.5-flash

# PDF Reports
REPORT_OUTPUT_DIR=reports

# Logging
LOG_LEVEL=INFO